<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.clickhouse.chdb</groupId>
    <artifactId>chdb-java-parent</artifactId>
    <version>1.0.0-rc.3-SNAPSHOT</version>
  </parent>
  <artifactId>chdb-arrow</artifactId>
  <name>chDB Arrow</name>
  <description>Optional Apache Arrow Java integration for chDB.</description>
  <dependencies>
    <dependency>
      <groupId>com.clickhouse.chdb</groupId>
      <artifactId>chdb-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-c-data</artifactId>
      <version>${arrow.java.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.java.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <!-- Netty's Arrow 19 allocator fails during initialization on JDK 25+.
           Use Arrow's Unsafe allocator for the same C Data API instead. -->
      <artifactId>arrow-memory-unsafe</artifactId>
      <version>${arrow.java.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.chdb.arrow</Automatic-Module-Name>
              <Implementation-Version>${project.version}</Implementation-Version>
              <chDB-Engine-Version>${chdb.engine.version}</chDB-Engine-Version>
              <chDB-JNI-ABI-Version>${chdb.jni.abi.version}</chDB-JNI-ABI-Version>
              <Arrow-Java-Version>${arrow.java.version}</Arrow-Java-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
            </executions>
            <configuration>
              <doclint>all,-accessibility</doclint>
              <quiet>true</quiet>
              <notimestamp>true</notimestamp>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

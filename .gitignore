# Build output
target/
build/
*.class

# Native artefacts: 350 MB of engine and a built shim. Produced by
# scripts/build-native.sh into <module>/target/native, never committed.
*.so
*.so.*
*.dylib
*.a
*.dSYM/
*.debug

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# The trap this repo hit once: passing --path=:memory: makes the engine create a
# directory of that name in the working directory. The driver no longer does, and
# StoragePathIT asserts it, but an older jar or another binding still can.
:memory:/


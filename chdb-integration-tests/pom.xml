<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.chdb</groupId>
    <artifactId>chdb-java-parent</artifactId>
    <version>26.7.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>chdb-integration-tests</artifactId>
  <packaging>jar</packaging>
  <name>chDB JDBC integration tests</name>
  <description>
    Tests that need a real engine: the type matrix, streaming, cancellation, signal handlers,
    the process-level storage path and the native loader. Not published.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <!--
      Where the two shared libraries live: exactly where scripts/build-native.sh stages them for
      this platform, so `mvn verify` works on a fresh checkout once the platform is staged.
      Override with -Dchdb.it.library.path to test a different pair, or leave the platform
      native JAR on the classpath and set it empty to exercise the JAR unpack path.

      Set whole by the platform profile below rather than composed from a platform id and an
      os/arch pair. Composing it let -Dchdb.it.platform=linux-x86_64-gnu on a Mac resolve to
      chdb-native-linux-x86_64-gnu/.../macos/aarch64 — a path that exists nowhere, produced
      silently. The value here is the no-profile-matched case and is meant to be unusable.

      An earlier default pointed at ../target/runtime/${chdb.it.platform}, which no script
      creates, with the platform hard-coded to macos-aarch64. It worked only on a machine where
      that directory happened to exist, and in CI, which passes the path explicitly — so a fresh
      clone failed everywhere and the failure was invisible to us.
    -->
    <chdb.it.library.path>${project.basedir}/../UNSUPPORTED-PLATFORM-no-profile-matched</chdb.it.library.path>

    <!--
      Sanitizer support (work plan section 5.11). Empty by default; scripts/run-sanitizer-tests.sh
      fills these in.

      These reach a surefire fork on Linux, where LD_PRELOAD survives. They do not on macOS:
      dyld drops DYLD_* from an environment handed to a hardened binary, so an ASan runtime
      cannot be preloaded into a fork there at all. scripts/run-sanitizer-tests.sh therefore
      execs the test JVM itself on both platforms and does not depend on these; they are kept
      because they make a plain `mvn verify` under LD_PRELOAD work on Linux. Both loaders
      ignore an empty value, so setting them unconditionally costs nothing.
    -->
    <chdb.it.sanitizer.preload></chdb.it.sanitizer.preload>
    <chdb.it.asan.options></chdb.it.asan.options>
    <chdb.it.ubsan.options></chdb.it.ubsan.options>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.chdb</groupId>
      <artifactId>chdb-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      For the sanitizer run, which drives JUnit directly rather than through Maven.
      scripts/run-sanitizer-tests.sh has to exec the test JVM itself: macOS strips DYLD_* from
      an environment handed to a hardened binary through ProcessBuilder, so a preloaded ASan
      runtime cannot reach a surefire fork. Exec'ing java from the shell does work.
    -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>1.10.2</version>
      <scope>test</scope>
    </dependency>

    <!--
      Frameworks the driver has to work under (work plan section 5.10). Test scope only: none of
      them is a dependency of the driver, and the point is to find out what a real pool and a
      real template do to a Connection that runs one statement at a time.

      Versions are the last ones supporting Java 11, which is the driver's floor: HikariCP 5.x
      and Spring Framework 5.3.x. Their 6.x/6.0 successors require Java 17, so testing those
      here would silently drop the floor from the matrix.
    -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>5.3.39</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.13</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Everything here is an *IT and belongs to failsafe. -->
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!--
            One JVM for the whole run, reused across classes. The engine binds a storage path
            per process and loads its libraries once, so forking per class would pay a 350 MB
            load repeatedly; the tests are written to leave no state behind instead.
          -->
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <!--
            ErrorFile points into target/ so a JVM crash leaves its report somewhere
            predictable and archivable. By default it lands in the forked JVM's working
            directory, which is this module, and CI's artifact step only collects target/ —
            so the one file that explains a SIGSEGV was the one file being thrown away.
          -->
          <argLine>-Xmx512m -XX:ErrorFile=${project.build.directory}/hs_err_pid%p.log
            -Dchdb.library.path=${chdb.it.library.path}</argLine>
          <systemPropertyVariables>
            <chdb.it.engine.version>${chdb.engine.version}</chdb.it.engine.version>
            <chdb.it.jni.abi.version>${chdb.jni.abi.version}</chdb.it.jni.abi.version>
          </systemPropertyVariables>
          <environmentVariables>
            <DYLD_INSERT_LIBRARIES>${chdb.it.sanitizer.preload}</DYLD_INSERT_LIBRARIES>
            <LD_PRELOAD>${chdb.it.sanitizer.preload}</LD_PRELOAD>
            <ASAN_OPTIONS>${chdb.it.asan.options}</ASAN_OPTIONS>
            <UBSAN_OPTIONS>${chdb.it.ubsan.options}</UBSAN_OPTIONS>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The platform triple, detected rather than assumed. Only one of these can activate, and
    every platform the project supports has one; a machine matching none gets an unresolved
    ${chdb.it.platform} and a path that plainly does not exist, which is a better failure than
    silently testing the wrong architecture's libraries.
  -->
  <!--
    The staged library directory for this machine, detected rather than assumed. Each profile
    sets the whole path, so there is no combination of properties that can name a directory for
    one platform under another. A machine matching none keeps the unusable default above, which
    fails with a path naming the reason.
  -->
  <profiles>
    <profile>
      <id>it-platform-macos-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <chdb.it.library.path>${project.basedir}/../chdb-native-macos-aarch64/target/native/META-INF/chdb/native/macos/aarch64</chdb.it.library.path>
      </properties>
    </profile>
    <profile>
      <id>it-platform-macos-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <chdb.it.library.path>${project.basedir}/../chdb-native-macos-x86_64/target/native/META-INF/chdb/native/macos/x86_64</chdb.it.library.path>
      </properties>
    </profile>
    <!-- os.arch is amd64 on a Linux x86_64 JDK, not x86_64; verified in a container. -->
    <profile>
      <id>it-platform-linux-x86_64</id>
      <activation><os><name>linux</name><arch>amd64</arch></os></activation>
      <properties>
        <chdb.it.library.path>${project.basedir}/../chdb-native-linux-x86_64-gnu/target/native/META-INF/chdb/native/linux/x86_64</chdb.it.library.path>
      </properties>
    </profile>
    <profile>
      <id>it-platform-linux-aarch64</id>
      <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
      <properties>
        <chdb.it.library.path>${project.basedir}/../chdb-native-linux-aarch64-gnu/target/native/META-INF/chdb/native/linux/aarch64</chdb.it.library.path>
      </properties>
    </profile>
  </profiles>
</project>

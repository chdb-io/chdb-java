<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.chdb</groupId>
    <artifactId>chdb-java-parent</artifactId>
    <version>26.7.3.1-SNAPSHOT</version>
  </parent>

  <artifactId>chdb-native-macos-x86_64</artifactId>
  <packaging>jar</packaging>
  <name>chDB native runtime for macos-x86_64</name>
  <description>
    chDB engine (libchdb) and JNI shim for macos-x86_64, plus the manifest, checksums, licences and SBOM
    that describe them. Depends on chdb-jdbc, so declaring only this package on a macos-x86_64 machine
    yields a complete runtime (work plan section 4.1).
  </description>

  <properties>
    <chdb.platform.id>macos-x86_64</chdb.platform.id>
    <chdb.platform.os>macos</chdb.platform.os>
    <chdb.platform.arch>x86_64</chdb.platform.arch>
    <chdb.jni.suffix>dylib</chdb.jni.suffix>
    <!-- Set by the platform-build profile below; the engine and shim are produced by
         scripts/build-native.sh rather than by Maven. -->
    <chdb.native.staging>${project.build.directory}/native</chdb.native.staging>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.chdb</groupId>
      <artifactId>chdb-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!--
        The two shared libraries and their metadata are staged by scripts/build-native.sh into
        target/native/META-INF/chdb/native/<os>/<arch>/ and picked up here. They are not in
        src/ because they are ~350 MB of build output and must never enter git.
      -->
      <resource>
        <directory>${chdb.native.staging}</directory>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.chdb.runtime.macos.x86_64</Automatic-Module-Name>
              <chDB-Platform>macos-x86_64</chDB-Platform>
              <chDB-Engine-Version>${chdb.engine.version}</chDB-Engine-Version>
              <chDB-JNI-ABI-Version>${chdb.jni.abi.version}</chDB-JNI-ABI-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Central requires a sources and a javadoc jar even for an artifact whose entire content is
      two shared libraries. There is no Java here to document, so these are empty by
      construction rather than by accident — maven-source-plugin would produce nothing at all
      and the upload would be rejected for a missing file. The sources are in this repository
      and the POM's <scm> says where.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>make-empty-dir</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/empty-for-central"/>
                    <!--
                      A release must not ship an empty native package. The two libraries are
                      staged by scripts/build-native.sh, not by Maven, so `mvn -Prelease deploy`
                      on a clean checkout would otherwise package a jar with no engine in it and
                      publish it to Central, where it cannot be taken back.
                    -->
                    <fail message="${project.artifactId} has not been staged: no ${chdb.native.staging}/META-INF/chdb/native/${chdb.platform.os}/${chdb.platform.arch}/libchdb.so. Run scripts/build-native.sh ${chdb.platform.id} on a ${chdb.platform.id} machine first; see docs/publishing.md.">
                      <condition>
                        <not>
                          <and>
                            <available file="${chdb.native.staging}/META-INF/chdb/native/${chdb.platform.os}/${chdb.platform.arch}/libchdb.so"/>
                            <available file="${chdb.native.staging}/META-INF/chdb/native/${chdb.platform.os}/${chdb.platform.arch}/libchdb_java_jni.${chdb.jni.suffix}"/>
                          </and>
                        </not>
                      </condition>
                    </fail>
                    <!--
                      And it must not be an engine built with —local-engine. That path skips the
                      pinned checksum on purpose, so nothing here knows which engine it is; the
                      shipped notice would describe the pinned release instead. fetch-libchdb.sh
                      records the provenance and build-native.sh copies it into the manifest.
                    -->
                    <fail message="${project.artifactId} was staged from a LOCAL engine (engine.source=local in manifest.properties). That build skips the pinned checksum and carries no licence inventory, so it must not be released. Re-stage without —local-engine.">
                      <condition>
                        <resourcecontains
                            resource="${chdb.native.staging}/META-INF/chdb/native/${chdb.platform.os}/${chdb.platform.arch}/manifest.properties"
                            substring="engine.source=local"/>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>empty-sources-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${project.build.directory}/empty-for-central</classesDirectory>
                  <forceCreation>true</forceCreation>
                  <skipIfEmpty>false</skipIfEmpty>
                </configuration>
              </execution>
              <execution>
                <id>empty-javadoc-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.build.directory}/empty-for-central</classesDirectory>
                  <forceCreation>true</forceCreation>
                  <skipIfEmpty>false</skipIfEmpty>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
